      },
      "outputs": [],
      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import pandas as pd\n",
        "from sklearn.impute import SimpleImputer"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "dataset = pd.read_csv('vgsales.csv')\n",
        "X = dataset[[\"Platform\",\"Year\",\"Genre\",\"Publisher\"]]\n",
        "y = dataset[\"Global_Sales\"]"
      ],
      "metadata": {
        "id": "ZAyhlwfs1CEu"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "print(X.isnull().sum())"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "h-GzemlG1w5b",
        "outputId": "10996e2a-a1e1-412d-d2e6-91f73334b1c5"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Platform       0\n",
            "Year         271\n",
            "Genre          0\n",
            "Publisher     58\n",
            "dtype: int64\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "from sklearn.impute import SimpleImputer\n",
        "imputer = SimpleImputer(strategy=\"most_frequent\")\n",
        "X[[\"Year\", \"Publisher\"]] = imputer.fit_transform(X[[\"Year\", \"Publisher\"]])"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "hs4K5RGV29KI",
        "outputId": "3160946a-1691-4085-fa77-d1fc0bd18fe4"
      },
      "execution_count": null,
